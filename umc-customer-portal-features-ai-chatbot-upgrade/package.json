{
  "name": "customer-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:daypop": "vite --mode daypopdevelopment",
    "dev:staging": "vite --mode nma-staging --force",
    "dev:force": "vite --force",
    "build": "cross-env DISABLE_ESLINT_PLUGIN=true vite build",
    "build:nma:dev": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode nma-development && npm run check:css-rem",
    "build:nma:staging": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode nma-staging && npm run check:css-rem",
    "build:nma:production": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --mode nma-production && npm run check:css-rem",
    "build:daypop": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --config vite.config.ts --mode daypopproduction && npm run check:css-rem",
    "build:client": "cross-env DISABLE_ESLINT_PLUGIN=true vite build --config vite.config.ts --mode client && npm run check:css-rem",
    "check:css-rem": "node scripts/check-css-rem-build.js",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check:import-case": "node scripts/check-import-path-case.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:daypop": "vite preview --mode daypopdevelopment",
    "prepare": "husky",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "@ant-design/cli": "^6.3.7",
    "@types/axios": "^0.14.4",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.5.2",
    "@types/react": "^17.0.89",
    "@types/react-dom": "^17.0.26",
    "@types/react-google-recaptcha": "^2.1.9",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.23",
    "code-inspector-plugin": "^1.5.1",
    "cross-env": "^10.1.0",
    "jsdom": "^29.1.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "postcss-pxtorem": "^6.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@ant-design/icons": "^4.8.3",
    "@designable/core": "^1.0.0-beta.45",
    "@designable/formily-antd": "^1.0.0-beta.45",
    "@designable/react": "^1.0.0-beta.45",
    "@designable/react-settings-form": "^1.0.0-beta.45",
    "@formily/antd": "^2.3.7",
    "@formily/core": "^2.3.7",
    "@formily/react": "^2.3.7",
    "@microsoft/signalr": "^9.0.6",
    "@reduxjs/toolkit": "^2.9.2",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "4.22.8",
    "axios": "^1.12.2",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.18",
    "dompurify": "^3.4.12",
    "framer-motion": "^6.5.1",
    "i18next": "^25.6.0",
    "less": "^4.4.2",
    "libphonenumber-js": "^1.13.8",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "patch-package": "^8.0.1",
    "pdfjs-dist": "5.4.296",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-google-recaptcha": "^3.1.0",
    "react-i18next": "^16.1.2",
    "react-router-dom": "^5.2.0",
    "rollup": "^4.50.2",
    "simplebar-react": "^3.3.2",
    "use-mask-input": "^3.9.0",
    "uuid": "^14.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^3.7.2"
  }
}
