POSTGRES_DB=dsh
POSTGRES_USER=dsh
POSTGRES_PASSWORD=replace-with-a-long-random-password

# External OpenAI-compatible model endpoint used to write the final answer.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace-me
LLM_MODEL=deepseek-v4-flash

# Existing knowledge service on 43.165.4.209 / port 18001.
KNOWLEDGE_BASE_URL=http://host.docker.internal:18001
KNOWLEDGE_PUBLIC_PATH=/api/knowledge
KNOWLEDGE_RETRIEVAL_MODES=bm25,graph,vector
KNOWLEDGE_UPSTREAM_MAX_TOP_K=20
KNOWLEDGE_TOP_K=20
# Set this when the deployment should search one fixed folder by default.
KNOWLEDGE_DEFAULT_FOLDER_ID=

# CPU OCR pair copied from the full Customer DSH deployment.
OCR_GATEWAY_URL=http://ocr-gateway:8100
OCR_VL_URL=http://ocr-cpu:8080
OCR_TIMEOUT_SECONDS=300
OCR_MODEL_NAME=tesseract-lstm
OCR_LANG=eng

CORS_ORIGINS=http://127.0.0.1:19087
DSH_BACKEND_PORT=19086
DSH_FRONTEND_PORT=19087
AUDIT_COOKIE_SECURE=false
