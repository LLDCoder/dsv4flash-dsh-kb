POSTGRES_DB=dsh
POSTGRES_USER=dsh
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=http://localhost:18080
FRONTEND_PORT=18080
RUNTIME_IDLE_TTL_SECONDS=900

# Optional OpenAI-compatible DS V4 Flash endpoint.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=60

# PaddleOCR-VL-1.6 internal gateway and official NVIDIA GPU services.
OCR_GATEWAY_URL=http://ocr-gateway:8100
OCR_VL_URL=http://ocr-vl-api:8080
OCR_TIMEOUT_SECONDS=300
OCR_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
OCR_VLM_BACKEND=vllm
OCR_API_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline
OCR_VLM_IMAGE_TAG_SUFFIX=latest-nvidia-gpu-offline
OCR_GPU_DEVICE=0

# UMC portals. Set UMC_PORTAL to `customer`, `admin` or `public`.
# Public falls back to the Customer Portal when UMC_PUBLIC_BASE_URL is blank.
# Login, identity lookup, document upload and document download all derive
# their API base URL from the selected portal.
# The customer URL may be entered with its `/login` frontend suffix; DSH strips
# that suffix before appending `/api/...`.
UMC_PORTAL=customer
UMC_CUSTOMER_BASE_URL=https://umc-customerportal.sol.daypop.ai
UMC_ADMIN_BASE_URL=https://umc-adminportal.sol.daypop.ai
UMC_PUBLIC_BASE_URL=
# Optional legacy endpoint overrides. Leave blank for the selected portal.
UMC_DOCUMENT_BASE_URL=
UMC_DOCUMENT_TIMEOUT_SECONDS=60
# The test console obtains the UMC token automatically with this configured
# service account. Keep the password only in the untracked local .env file.
UMC_LOGIN_URL=
UMC_LOGIN_EMAIL=
UMC_LOGIN_PASSWORD=
UMC_LOGIN_TIMEOUT_SECONDS=30

# Chain audit storage. Audit rows are retained for this many days and removed
# by the backend sweeper at the configured interval; conversation history is
# not deleted by this policy.
AUDIT_RETENTION_DAYS=30
AUDIT_CLEANUP_INTERVAL_SECONDS=3600

# 77 knowledge proxy. DSH uses the anonymous proxy with the caller's UMC token.
KNOWLEDGE_GATEWAY_URL=http://knowledge-gateway:8101
KNOWLEDGE_BASE_URL=http://77.242.240.158:18085/api/platform/api/v1
KNOWLEDGE_TIMEOUT_SECONDS=30
KNOWLEDGE_RETRY_ATTEMPTS=3
# The current 77 anonymous proxy rejects top_k above 20; DSH keeps its
# logical top_k=32 and caps only the upstream wire request at this value.
KNOWLEDGE_UPSTREAM_MAX_TOP_K=20
KNOWLEDGE_RETRIEVAL_MODES=bm25,graph,vector
KNOWLEDGE_TOP_K=32
# Optional default folder for automatic knowledge routing; keep empty for multi-folder tenants.
KNOWLEDGE_DEFAULT_FOLDER_ID=

# 77 platform Swagger service (same server IP, platform mount differs from knowledge API).
PLATFORM_GATEWAY_URL=http://platform-gateway:8102
PLATFORM_BASE_URL=http://77.242.240.158:18085/api/platform
PLATFORM_TIMEOUT_SECONDS=30
PLATFORM_RETRY_ATTEMPTS=2
# The test console obtains a short-lived token automatically from UMC_LOGIN_*;
# external production callers may still supply their own UMC token per request.
EXTERNAL_TOOLS_ENABLED=true
